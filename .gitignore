# .gitignore — sr-next-influencer

# Data (too large / sensitive for Git)
data/
session/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
venv/
.venv/

# Environment / secrets
.env
.env.*

# Models (large binary files)
models/*.joblib

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
